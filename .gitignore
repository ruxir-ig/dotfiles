# Fish runtime state
.config/fish/fish_variables
.config/fish/completions/

# Ollama local identity/history
.ollama/id_*
.ollama/history

# Helix runtime cache/cloned grammars
.config/helix/runtime/

# Btop themes (usually from package manager)
.config/btop/themes/

# Cava shaders/themes (if auto-generated)
.config/cava/shaders/

# Rofi image cache
.config/rofi/images/

# Hyprland backups (auto-generated)
.config/hypr/*.backup*

# Ghostty backups
.config/ghostty/*.backup*

# Editor swap/backup files
*~
*.swp
*.swo
*.bak
\#*\#

# Nimble package manager state/packages
.nimble/

# IPython history (local usage data)
.ipython/profile_default/history.sqlite

# DMS auto-generated backups
.config/hypr/.dms-backups/

# Systemd user enable-state symlinks (machine-local)
.config/systemd/user/*.target.wants/

# OS files
.DS_Store
Thumbs.db
