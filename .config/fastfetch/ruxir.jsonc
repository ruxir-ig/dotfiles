{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/ruxir-signature.png",
    "position": "top",
    "padding": {
      "top": 3,
      "bottom": 0
    }
  },
  "display": {
    "separator": " ",
    "brightColor": true,
    "key": {
      "width": 16
    },
    "size": {
      "ndigits": 0,
      "maxPrefix": "MB",
      "binaryPrefix": "iec"
    }
  },
  "modules": [
    { "type": "custom", "key": "╭──────────╮", "format": "" },
    {
      "type": "title",
      "key": "│   user  │",
      "keyColor": "yellow",
      "format": "{#light_red}{user-name}"
    },
    {
      "type": "title",
      "key": "│   hname │",
      "keyColor": "yellow",
      "format": "{#yellow}{host-name}"
    },
    {
      "type": "os",
      "key": "│ 󰣇  distro│",
      "keyColor": "green",
      "format": "{#green}{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "│   kernel│",
      "keyColor": "blue",
      "format": "{#blue}{release}"
    },
    {
      "type": "uptime",
      "key": "│ 󰥔  uptime│",
      "keyColor": "blue",
      "format": "{#blue}{hours}h {minutes}m"
    },
    {
      "type": "command",
      "key": "│   shell │",
      "keyColor": "cyan",
      "text": "basename \"$SHELL\"",
      "format": "{#cyan}{}"
    },
    {
      "type": "packages",
      "key": "│ 󰏖  pkgs  │",
      "keyColor": "light_red",
      "format": "{#light_red}{pacman}"
    },
    {
      "type": "memory",
      "key": "│   memory│",
      "keyColor": "yellow",
      "format": "{#yellow}{used} | {total}"
    },
    { "type": "custom", "key": "├──────────┤", "format": "" },
    {
      "type": "colors",
      "key": "│   colors│",
      "keyColor": "white",
      "symbol": "circle"
    },
    { "type": "custom", "key": "╰──────────╯", "format": "" }
  ]
}
