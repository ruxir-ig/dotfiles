[Unit]
Description=T3 Code server
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h
Environment=T3CODE_HOME=/home/ruxir/.t3
Environment=T3_BOOT_SERVICE_UNIT=t3code.service
ExecStart=/home/ruxir/.vite-plus/js_runtime/node/24.19.0/bin/node /home/ruxir/.t3/runtime/service-launcher.mjs
KillMode=mixed
OOMPolicy=continue
Restart=always
RestartSec=5
StandardOutput=append:/home/ruxir/.t3/userdata/logs/boot-service.log
StandardError=append:/home/ruxir/.t3/userdata/logs/boot-service.log

[Install]
WantedBy=default.target
