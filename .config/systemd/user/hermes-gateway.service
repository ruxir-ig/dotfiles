[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/home/ruxir/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run --replace
WorkingDirectory=/home/ruxir/.hermes/hermes-agent
Environment="PATH=/home/ruxir/.hermes/hermes-agent/venv/bin:/home/ruxir/.hermes/hermes-agent/node_modules/.bin:/usr/bin:/home/ruxir/.local/bin:/home/ruxir/.cargo/bin:/home/ruxir/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/ruxir/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=/home/ruxir/.hermes"
Restart=on-failure
RestartSec=30
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
